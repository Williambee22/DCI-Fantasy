<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Fantasy drum corps drafting and scoring leagues">
  <title><%= title ? `${title} · ${appName}` : appName %></title>
  <link rel="stylesheet" href="/app.css">
</head>
<body>
  <header class="site-header">
    <div class="shell nav-wrap">
      <a class="brand" href="/">Corps<span>Draft</span></a>
      <nav class="nav-links" aria-label="Primary navigation">
        <% if (currentUser) { %>
          <a href="/dashboard" class="<%= path === '/dashboard' ? 'active' : '' %>">Dashboard</a>
          <% if (currentUser.site_role === 'ADMIN') { %>
            <a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>">Head Admin</a>
          <% } %>
          <form method="post" action="/logout" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="link-button" type="submit">Log out</button>
          </form>
        <% } else { %>
          <a href="/login">Log in</a>
          <a class="button small" href="/register">Create account</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="shell page">
    <% if (flash) { %>
      <div class="flash <%= flash.type %>" role="status"><%= flash.message %></div>
    <% } %>
