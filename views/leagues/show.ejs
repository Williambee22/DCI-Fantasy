<%- include('../partials/header') %>

<div class="page-heading split-heading">
  <div>
    <p class="eyebrow">League</p>

    <h1><%= league.name %></h1>

    <p class="muted">
      <%= league.season_year %> season ·
      Invite code:
      <strong class="invite-code">
        <%= league.invite_code %>
      </strong>
    </p>
  </div>

  <div class="heading-actions">
    <% if (
      league.draft_status === 'SETUP'
      && league.is_commissioner
    ) { %>
      <form
        method="post"
        action="/leagues/<%= league.id %>/draft/start"
      >
        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >

        <button
          class="button"
          name="mode"
          value="random"
          type="submit"
        >
          Randomize &amp; start
        </button>
      </form>

      <form
        method="post"
        action="/leagues/<%= league.id %>/draft/start"
      >
        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >

        <button
          class="button secondary"
          name="mode"
          value="saved"
          type="submit"
        >
          Start saved order
        </button>
      </form>
    <% } else if (league.draft_status !== 'SETUP') { %>
      <a
        class="button"
        href="/leagues/<%= league.id %>/draft"
      >
        Open draft room
      </a>
    <% } %>
  </div>
</div>

<section class="panel roster-rule-panel">
  <p class="eyebrow">Draft structure</p>

  <h2>
    <%= requiredPicksPerTeam %> required picks per team
  </h2>

  <p class="muted">
    Every manager must draft exactly one Content selection
    and one Achievement selection from every caption.
    Each exact corps, caption, and subcaption combination
    can only be drafted once in this league.
  </p>
</section>

<% if (
  league.draft_status === 'SETUP'
  && league.is_commissioner
) { %>
  <section class="panel draft-order-editor">
    <div class="section-title-row">
      <div>
        <p class="eyebrow">Commissioner</p>

        <h2>Set draft order</h2>

        <p class="muted">
          Assign every team a unique position, save it,
          then choose “Start saved order.”
        </p>
      </div>
    </div>

    <form
      method="post"
      action="/leagues/<%= league.id %>/draft/order"
    >
      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <div class="order-editor-grid">
        <% members.forEach((member, index) => { %>
          <label>
            <span>
              <strong><%= member.team_name %></strong>
              <small>@<%= member.username %></small>
            </span>

            <select
              name="positions[<%= member.user_id %>]"
              required
            >
              <% members.forEach((_, positionIndex) => {
                const position = positionIndex + 1;
                const selectedPosition = Number(
                  member.draft_position || index + 1
                );
              %>
                <option
                  value="<%= position %>"
                  <%= selectedPosition === position
                    ? 'selected'
                    : '' %>
                >
                  <%= position %>
                </option>
              <% }) %>
            </select>
          </label>
        <% }) %>
      </div>

      <button
        class="button secondary small"
        type="submit"
      >
        Save draft order
      </button>
    </form>
  </section>
<% } %>

<div class="league-layout">
  <section class="panel main-panel">
    <div class="section-title-row">
      <div>
        <p class="eyebrow">Leaderboard</p>
        <h2>Season standings</h2>
      </div>

      <span
        class="status <%= league.draft_status.toLowerCase() %>"
      >
        <%= league.draft_status %>
      </span>
    </div>

    <div class="table-wrap">
      <table class="data-table standings-table">
        <thead>
          <tr>
            <th>Place</th>
            <th>Team</th>
            <th>Manager</th>
            <th>Assets</th>
            <th>Weighted points</th>
          </tr>
        </thead>

        <tbody>
          <% if (!standings.length) { %>
            <tr>
              <td
                colspan="5"
                class="muted"
              >
                No teams are available.
              </td>
            </tr>
          <% } %>

          <% standings.forEach((team, index) => { %>
            <tr>
              <td class="place">
                <%= index + 1 %>
              </td>

              <td>
                <strong><%= team.team_name %></strong>
              </td>

              <td>
                @<%= team.username %>
              </td>

              <td>
                <%= team.drafted_assets %>/<%= requiredPicksPerTeam %>
              </td>

              <td class="score">
                <%= formatScore(team.total_points) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <aside class="panel side-panel">
    <p class="eyebrow">Your team</p>

    <h2><%= league.team_name %></h2>

    <form
      method="post"
      action="/leagues/<%= league.id %>/team-name"
      class="stack-form compact"
    >
      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <label>
        Rename team

        <input
          name="team_name"
          value="<%= league.team_name %>"
          maxlength="80"
          required
        >
      </label>

      <button
        class="button secondary small"
        type="submit"
      >
        Save name
      </button>
    </form>

    <% if (league.is_commissioner) { %>
      <hr>

      <p class="eyebrow">Commissioner controls</p>

      <p class="muted">
        Caption multipliers can be changed below.
        Standings recalculate immediately after saving.
      </p>

      <% if (league.draft_status !== 'SETUP') { %>
        <form
          method="post"
          action="/leagues/<%= league.id %>/draft/reset"
          class="stack-form compact danger-zone"
          onsubmit="return confirm('Reset the entire draft and remove every pick?');"
        >
          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >

          <button
            class="button danger small"
            type="submit"
          >
            Reset entire draft
          </button>
        </form>
      <% } %>
    <% } %>
  </aside>
</div>

<section class="section-block panel scoring-settings-panel">
  <div class="section-title-row">
    <div>
      <p class="eyebrow">League scoring</p>

      <h2>Caption multipliers</h2>

      <p class="muted">
        A multiplier of 1.000 gives the subcaption its normal
        value. Use 0.500 for half value, 2.000 for double
        value, or 0.000 to exclude it from scoring.
      </p>
    </div>
  </div>

  <% if (league.is_commissioner) { %>
    <form
      method="post"
      action="/leagues/<%= league.id %>/scoring"
    >
      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <div class="table-wrap">
        <table class="data-table weight-table">
          <thead>
            <tr>
              <th>Caption</th>
              <th>Content label</th>
              <th>Content multiplier</th>
              <th>Achievement label</th>
              <th>Achievement multiplier</th>
            </tr>
          </thead>

          <tbody>
            <% captionWeights.forEach((caption) => { %>
              <tr>
                <td>
                  <strong><%= caption.name %></strong>
                </td>

                <td>
                  <%= caption.first_label %>
                </td>

                <td>
                  <input
                    type="number"
                    name="first_weights[<%= caption.code %>]"
                    min="0"
                    max="10"
                    step="0.001"
                    value="<%= Number(caption.first_weight).toFixed(3) %>"
                    aria-label="<%= caption.name %> <%= caption.first_label %> multiplier"
                    required
                  >
                </td>

                <td>
                  <%= caption.second_label %>
                </td>

                <td>
                  <input
                    type="number"
                    name="second_weights[<%= caption.code %>]"
                    min="0"
                    max="10"
                    step="0.001"
                    value="<%= Number(caption.second_weight).toFixed(3) %>"
                    aria-label="<%= caption.name %> <%= caption.second_label %> multiplier"
                    required
                  >
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <button
        class="button top-gap"
        type="submit"
      >
        Save scoring multipliers
      </button>
    </form>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table weight-table">
        <thead>
          <tr>
            <th>Caption</th>
            <th>Content label</th>
            <th>Multiplier</th>
            <th>Achievement label</th>
            <th>Multiplier</th>
          </tr>
        </thead>

        <tbody>
          <% captionWeights.forEach((caption) => { %>
            <tr>
              <td>
                <strong><%= caption.name %></strong>
              </td>

              <td>
                <%= caption.first_label %>
              </td>

              <td>
                ×<%= Number(caption.first_weight).toFixed(3) %>
              </td>

              <td>
                <%= caption.second_label %>
              </td>

              <td>
                ×<%= Number(caption.second_weight).toFixed(3) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="section-block">
  <div class="section-title-row">
    <div>
      <p class="eyebrow">Rosters</p>
      <h2>Drafted assets</h2>
    </div>
  </div>

  <div class="roster-grid">
    <% members.forEach((member) => {
      const picks = rosters[member.user_id] || [];
    %>
      <article class="panel roster-card">
        <div class="roster-head">
          <div>
            <h3><%= member.team_name %></h3>
            <p>@<%= member.username %></p>
          </div>

          <strong>
            <%= picks.length %>/<%= requiredPicksPerTeam %>
          </strong>
        </div>

        <% if (!picks.length) { %>
          <p class="muted">
            No picks yet.
          </p>
        <% } %>

        <ol class="asset-list">
          <% picks.forEach((pick) => { %>
            <li>
              <div>
                <span class="pick-num">
                  #<%= pick.pick_number %>
                </span>

                <strong>
                  <%= pick.corps_name %>
                </strong>

                <small>
                  <%= pick.caption_name %> ·
                  <%= pick.component === 'FIRST'
                    ? pick.first_label
                    : pick.second_label %> ·
                  ×<%= Number(pick.component_weight).toFixed(3) %>
                </small>
              </div>

              <span class="asset-points">
                <%= formatScore(pick.points) %>
              </span>
            </li>
          <% }) %>
        </ol>
      </article>
    <% }) %>
  </div>
</section>

<%- include('../partials/footer') %>
