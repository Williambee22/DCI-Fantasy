<%- include('../partials/header') %>

<%
  const recapGroups = [
    {
      title: 'GENERAL EFFECT',
      totalLabel: 'GE TOT',
      totalField: 'ge_points',
      captions: ['GE1', 'GE2']
    },
    {
      title: 'VISUAL',
      totalLabel: 'VIS TOT',
      totalField: 'visual_points',
      captions: ['VP', 'VA', 'CG']
    },
    {
      title: 'MUSIC',
      totalLabel: 'MUS TOT',
      totalField: 'music_points',
      captions: ['BRASS', 'MA', 'PERC']
    }
  ];

  const captionByCode = Object.fromEntries(
    captionWeights.map((caption) => [
      caption.code,
      caption
    ])
  );

  const standingsByUser = Object.fromEntries(
    standings.map((team) => [
      String(team.user_id),
      team
    ])
  );

  const safeNumber = (value) => {
    const parsed = Number(value);
    return Number.isFinite(parsed) ? parsed : 0;
  };

  const findPick = (
    picks,
    captionCode,
    component
  ) => (
    picks.find(
      (pick) =>
        pick.caption_code === captionCode
        && pick.component === component
    )
  );

  const pickRawScore = (pick) => {
    if (!pick) {
      return null;
    }

    if (pick.raw_points != null) {
      return safeNumber(pick.raw_points);
    }

    if (pick.weighted_points != null) {
      return safeNumber(pick.weighted_points);
    }

    return safeNumber(pick.points);
  };

  const pickWeightedScore = (pick) => {
    if (!pick) {
      return 0;
    }

    if (pick.weighted_points != null) {
      return safeNumber(pick.weighted_points);
    }

    return (
      safeNumber(pickRawScore(pick))
      * safeNumber(pick.component_weight || 1)
    );
  };
%>

<div class="page-heading split-heading">
  <div>
    <p class="eyebrow">League</p>

    <h1><%= league.name %></h1>

    <p class="muted">
      <%= league.season_year %> season ·
      Invite code:

      <strong class="invite-code">
        <%= league.invite_code %>
      </strong>
    </p>
  </div>

  <div class="heading-actions">
    <% if (
      league.draft_status === 'SETUP'
      && league.is_commissioner
    ) { %>
      <form
        method="post"
        action="/leagues/<%= league.id %>/draft/start"
      >
        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >

        <button
          class="button"
          name="mode"
          value="random"
          type="submit"
        >
          Randomize &amp; start
        </button>
      </form>

      <form
        method="post"
        action="/leagues/<%= league.id %>/draft/start"
      >
        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >

        <button
          class="button secondary"
          name="mode"
          value="saved"
          type="submit"
        >
          Start saved order
        </button>
      </form>
    <% } else if (
      league.draft_status !== 'SETUP'
    ) { %>
      <a
        class="button"
        href="/leagues/<%= league.id %>/draft"
      >
        Open draft room
      </a>
    <% } %>
  </div>
</div>

<section class="panel roster-rule-panel">
  <p class="eyebrow">Draft structure</p>

  <h2>
    <%= requiredPicksPerTeam %> required picks per team
  </h2>

  <p class="muted">
    Every manager must fill both subcaption positions
    for every caption. Each exact corps, caption, and
    subcaption combination can only be drafted once
    throughout the league.
  </p>
</section>

<% if (
  league.draft_status === 'SETUP'
  && league.is_commissioner
) { %>
  <section class="panel draft-order-editor">
    <div class="section-title-row">
      <div>
        <p class="eyebrow">Commissioner</p>

        <h2>Set draft order</h2>

        <p class="muted">
          Assign every team a unique position, save it,
          then choose “Start saved order.”
        </p>
      </div>
    </div>

    <form
      method="post"
      action="/leagues/<%= league.id %>/draft/order"
    >
      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <div class="order-editor-grid">
        <% members.forEach((member, index) => { %>
          <label>
            <span>
              <strong>
                <%= member.team_name %>
              </strong>

              <small>
                @<%= member.username %>
              </small>
            </span>

            <select
              name="positions[<%= member.user_id %>]"
              required
            >
              <% members.forEach(
                (_, positionIndex) => {
                  const position =
                    positionIndex + 1;

                  const selectedPosition =
                    Number(
                      member.draft_position
                      || index + 1
                    );
              %>
                <option
                  value="<%= position %>"
                  <%= selectedPosition === position
                    ? 'selected'
                    : '' %>
                >
                  <%= position %>
                </option>
              <% }) %>
            </select>
          </label>
        <% }) %>
      </div>

      <button
        class="button secondary small"
        type="submit"
      >
        Save draft order
      </button>
    </form>
  </section>
<% } %>

<div class="league-layout">
  <section class="panel main-panel">
    <div class="section-title-row">
      <div>
        <p class="eyebrow">Leaderboard</p>
        <h2>Season standings</h2>
      </div>

      <span
        class="status <%= league.draft_status.toLowerCase() %>"
      >
        <%= league.draft_status %>
      </span>
    </div>

    <div class="table-wrap">
      <table class="data-table standings-table">
        <thead>
          <tr>
            <th>Place</th>
            <th>Team</th>
            <th>Manager</th>
            <th>Assets</th>
            <th>GE</th>
            <th>Visual</th>
            <th>Music</th>
            <th>Total</th>
          </tr>
        </thead>

        <tbody>
          <% if (!standings.length) { %>
            <tr>
              <td
                colspan="8"
                class="muted"
              >
                No teams are available.
              </td>
            </tr>
          <% } %>

          <% standings.forEach(
            (team, index) => {
          %>
            <tr>
              <td class="place">
                <%= index + 1 %>
              </td>

              <td>
                <strong>
                  <%= team.team_name %>
                </strong>
              </td>

              <td>
                @<%= team.username %>
              </td>

              <td>
                <%= team.drafted_assets %>/<%= requiredPicksPerTeam %>
              </td>

              <td class="score">
                <%= formatScore(team.ge_points) %>
              </td>

              <td class="score">
                <%= formatScore(team.visual_points) %>
              </td>

              <td class="score">
                <%= formatScore(team.music_points) %>
              </td>

              <td class="score overall-score">
                <%= formatScore(team.total_points) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <aside class="panel side-panel">
    <p class="eyebrow">Your team</p>

    <h2><%= league.team_name %></h2>

    <form
      method="post"
      action="/leagues/<%= league.id %>/team-name"
      class="stack-form compact"
    >
      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <label>
        Rename team

        <input
          name="team_name"
          value="<%= league.team_name %>"
          maxlength="80"
          required
        >
      </label>

      <button
        class="button secondary small"
        type="submit"
      >
        Save name
      </button>
    </form>

    <% if (league.is_commissioner) { %>
      <hr>

      <p class="eyebrow">
        Commissioner controls
      </p>

      <p class="muted">
        Caption multipliers can be changed below.
        Standings recalculate immediately after saving.
      </p>

      <% if (
        league.draft_status !== 'SETUP'
      ) { %>
        <form
          method="post"
          action="/leagues/<%= league.id %>/draft/reset"
          class="stack-form compact danger-zone"
          onsubmit="return confirm('Reset the entire draft and remove every pick?');"
        >
          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >

          <button
            class="button danger small"
            type="submit"
          >
            Reset entire draft
          </button>
        </form>
      <% } %>
    <% } %>
  </aside>
</div>

<section
  class="section-block panel scoring-settings-panel"
>
  <div class="section-title-row">
    <div>
      <p class="eyebrow">League scoring</p>

      <h2>Caption multipliers</h2>

      <p class="muted">
        Commissioner multipliers are applied to each
        individual subcaption score before the DCI
        section formula is calculated.
      </p>

      <div class="scoring-formula">
        <span>
          <strong>General Effect</strong>
          GE1 + GE2 = 40.000
        </span>

        <span>
          <strong>Visual</strong>
          (VP + VA + CG) ÷ 2 = 30.000
        </span>

        <span>
          <strong>Music</strong>
          (Brass + MA + Percussion) ÷ 2 = 30.000
        </span>

        <span>
          <strong>Overall</strong>
          GE + Visual + Music = 100.000
        </span>
      </div>

      <p class="muted">
        A multiplier of 1.000 gives a subcaption its
        normal value. Use 0.500 for half value, 2.000
        for double value, or 0.000 to remove it from
        league scoring.
      </p>
    </div>
  </div>

  <% if (league.is_commissioner) { %>
    <form
      method="post"
      action="/leagues/<%= league.id %>/scoring"
    >
      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <div class="table-wrap">
        <table class="data-table weight-table">
          <thead>
            <tr>
              <th>Caption</th>
              <th>First subcaption</th>
              <th>Multiplier</th>
              <th>Second subcaption</th>
              <th>Multiplier</th>
            </tr>
          </thead>

          <tbody>
            <% captionWeights.forEach(
              (caption) => {
            %>
              <tr>
                <td>
                  <strong>
                    <%= caption.name %>
                  </strong>
                </td>

                <td>
                  <%= caption.first_label %>
                </td>

                <td>
                  <input
                    type="number"
                    name="first_weights[<%= caption.code %>]"
                    min="0"
                    max="10"
                    step="0.001"
                    value="<%= safeNumber(caption.first_weight).toFixed(3) %>"
                    aria-label="<%= caption.name %> <%= caption.first_label %> multiplier"
                    required
                  >
                </td>

                <td>
                  <%= caption.second_label %>
                </td>

                <td>
                  <input
                    type="number"
                    name="second_weights[<%= caption.code %>]"
                    min="0"
                    max="10"
                    step="0.001"
                    value="<%= safeNumber(caption.second_weight).toFixed(3) %>"
                    aria-label="<%= caption.name %> <%= caption.second_label %> multiplier"
                    required
                  >
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <button
        class="button top-gap"
        type="submit"
      >
        Save scoring multipliers
      </button>
    </form>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table weight-table">
        <thead>
          <tr>
            <th>Caption</th>
            <th>First subcaption</th>
            <th>Multiplier</th>
            <th>Second subcaption</th>
            <th>Multiplier</th>
          </tr>
        </thead>

        <tbody>
          <% captionWeights.forEach(
            (caption) => {
          %>
            <tr>
              <td>
                <strong>
                  <%= caption.name %>
                </strong>
              </td>

              <td>
                <%= caption.first_label %>
              </td>

              <td>
                ×<%= safeNumber(
                  caption.first_weight
                ).toFixed(3) %>
              </td>

              <td>
                <%= caption.second_label %>
              </td>

              <td>
                ×<%= safeNumber(
                  caption.second_weight
                ).toFixed(3) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section
  class="section-block panel fantasy-recap-panel"
>
  <div class="section-title-row">
    <div>
      <p class="eyebrow">Fantasy recap</p>

      <h2>Drafted caption sheet</h2>

      <p class="muted">
        Each subcaption cell shows the corps drafted
        for that position and its recorded score.
        Missing cells show exactly what each team
        still needs to draft.
      </p>
    </div>
  </div>

  <div class="table-wrap fantasy-recap-wrap">
    <table class="data-table fantasy-recap-table">
      <thead>
        <tr class="recap-section-row">
          <th
            rowspan="3"
            class="recap-team-column"
          >
            TEAM
          </th>

          <% recapGroups.forEach(
            (group) => {
          %>
            <th
              colspan="<%= group.captions.length * 3 + 1 %>"
              class="recap-section-heading"
            >
              <%= group.title %>
            </th>
          <% }) %>

          <th
            rowspan="3"
            class="recap-overall-heading"
          >
            TOTAL
          </th>
        </tr>

        <tr class="recap-caption-row">
          <% recapGroups.forEach(
            (group) => {
          %>
            <% group.captions.forEach(
              (captionCode) => {
                const caption =
                  captionByCode[captionCode];
            %>
              <th colspan="3">
                <%= caption
                  ? caption.name
                  : captionCode %>
              </th>
            <% }) %>

            <th
              rowspan="2"
              class="recap-total-heading"
            >
              <%= group.totalLabel %>
            </th>
          <% }) %>
        </tr>

        <tr class="recap-subcaption-row">
          <% recapGroups.forEach(
            (group) => {
          %>
            <% group.captions.forEach(
              (captionCode) => {
                const caption =
                  captionByCode[captionCode];
            %>
              <th>
                <%= caption
                  ? caption.first_label
                  : 'Content' %>
              </th>

              <th>
                <%= caption
                  ? caption.second_label
                  : 'Achievement' %>
              </th>

              <th class="recap-caption-total-heading">
                TOT
              </th>
            <% }) %>
          <% }) %>
        </tr>
      </thead>

      <tbody>
        <% members.forEach((member) => {
          const picks =
            rosters[member.user_id] || [];

          const teamStanding =
            standingsByUser[
              String(member.user_id)
            ] || {
              ge_points: 0,
              visual_points: 0,
              music_points: 0,
              total_points: 0
            };
        %>
          <tr>
            <th class="recap-team-cell">
              <strong>
                <%= member.team_name %>
              </strong>

              <small>
                @<%= member.username %>
              </small>

              <span>
                <%= picks.length %>/<%= requiredPicksPerTeam %>
              </span>
            </th>

            <% recapGroups.forEach(
              (group) => {
            %>
              <% group.captions.forEach(
                (captionCode) => {
                  const firstPick = findPick(
                    picks,
                    captionCode,
                    'FIRST'
                  );

                  const secondPick = findPick(
                    picks,
                    captionCode,
                    'SECOND'
                  );

                  const firstScore =
                    pickRawScore(firstPick);

                  const secondScore =
                    pickRawScore(secondPick);

                  const captionTotal =
                    pickWeightedScore(firstPick)
                    + pickWeightedScore(secondPick);

                  const captionComplete =
                    Boolean(
                      firstPick && secondPick
                    );
              %>
                <td
                  class="recap-slot <%= firstPick
                    ? 'recap-slot-filled'
                    : 'recap-slot-missing' %>"
                >
                  <% if (firstPick) { %>
                    <strong>
                      <%= firstPick.corps_name %>
                    </strong>

                    <small>
                      <%= formatScore(firstScore) %>
                    </small>

                    <% if (
                      safeNumber(
                        firstPick.component_weight
                      ) !== 1
                    ) { %>
                      <span class="recap-multiplier">
                        ×<%= safeNumber(
                          firstPick.component_weight
                        ).toFixed(3) %>
                      </span>
                    <% } %>
                  <% } else { %>
                    <strong>MISSING</strong>
                    <small>—</small>
                  <% } %>
                </td>

                <td
                  class="recap-slot <%= secondPick
                    ? 'recap-slot-filled'
                    : 'recap-slot-missing' %>"
                >
                  <% if (secondPick) { %>
                    <strong>
                      <%= secondPick.corps_name %>
                    </strong>

                    <small>
                      <%= formatScore(secondScore) %>
                    </small>

                    <% if (
                      safeNumber(
                        secondPick.component_weight
                      ) !== 1
                    ) { %>
                      <span class="recap-multiplier">
                        ×<%= safeNumber(
                          secondPick.component_weight
                        ).toFixed(3) %>
                      </span>
                    <% } %>
                  <% } else { %>
                    <strong>MISSING</strong>
                    <small>—</small>
                  <% } %>
                </td>

                <td
                  class="score recap-caption-total <%= captionComplete
                    ? ''
                    : 'recap-partial-total' %>"
                >
                  <%= formatScore(
                    captionTotal
                  ) %>

                  <% if (!captionComplete) { %>
                    <small>PARTIAL</small>
                  <% } %>
                </td>
              <% }) %>

              <td class="score recap-section-total">
                <%= formatScore(
                  teamStanding[group.totalField]
                ) %>
              </td>
            <% }) %>

            <td class="score recap-overall-total">
              <%= formatScore(
                teamStanding.total_points
              ) %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/footer') %>
